/* Tokyo Night Theme for Rofi */

* {
    font: "JetBrainsMono Nerd Font 12";

    bg0:    #1a1b26EE;
    bg1:    #24283b;
    bg2:    #292e4299;
    accent: #7aa2f7;
    purple: #bb9af7;

    fg0:    #c0caf5;
    fg1:    #a9b1d6;
    fg3:    #565f89;

    background-color: transparent;
    text-color:       @fg0;

    margin:  0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location:         north;
    y-offset:         calc(50% - 220px);
    width:            540px;
    border-radius:    20px;
    background-color: @bg0;
    border:           2px solid;
    border-color:     @accent;
}

mainbox {
    padding: 16px;
}

inputbar {
    background-color: @bg1;
    border-color:     @accent;
    border:           2px solid;
    border-radius:    14px;
    padding:          10px 18px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg3;
}

message {
    margin:           12px 0 0;
    border-radius:    14px;
    background-color: @bg2;
}

textbox {
    padding: 8px 20px;
}

listview {
    background-color: transparent;
    margin:           12px 0 0;
    lines:            8;
    columns:          1;
    fixed-height:     false;
    spacing:          4px;
}

element {
    padding:       10px 16px;
    spacing:       10px;
    border-radius: 12px;
}

element normal active {
    text-color: @purple;
}

element alternate active {
    text-color: @purple;
}

element selected normal,
element selected active {
    background-color: @bg1;
    text-color:       @accent;
    border:           0 0 2px 0 solid;
    border-color:     @accent;
}

element-icon {
    size:           1.2em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
